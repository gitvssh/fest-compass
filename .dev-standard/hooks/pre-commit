#!/bin/sh
# dev-standard 컴플라이언스 게이트 (core.hooksPath로 연결, 폐쇄망·WSL 안전).
# 프레임워크·심볼릭 링크·다운로드 없음. severity=warn이면 통과, error면 차단.
repo_root="$(git rev-parse --show-toplevel)"
checker="$repo_root/.dev-standard/check_compliance.py"
export PYTHONUTF8=1
export PYTHONIOENCODING=utf-8

if command -v python3 >/dev/null 2>&1 && python3 --version >/dev/null 2>&1; then
  exec python3 "$checker" --root "$repo_root"
elif command -v python >/dev/null 2>&1 && python --version >/dev/null 2>&1; then
  exec python "$checker" --root "$repo_root"
elif command -v py >/dev/null 2>&1 && py -3 --version >/dev/null 2>&1; then
  exec py -3 "$checker" --root "$repo_root"
fi

echo "dev-standard: Python 3 실행기를 찾을 수 없습니다." >&2
exit 1
