{
  "name": "fest-compass",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.7.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=10.7.0 <12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run forecast:trial:verify && prisma generate && next build && npm run build:seed && npm run build:forecast && node scripts/sanitize-standalone.mjs",
    "build:forecast": "esbuild scripts/forecast-worker.ts --bundle --platform=node --format=cjs --outfile=.next/forecast-worker.cjs",
    "forecast:seed": "tsx scripts/build-forecast-seed.ts",
    "build:seed": "esbuild prisma/seed.ts --bundle --platform=node --format=cjs --outfile=.next/seed.cjs --external:@prisma/client",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:baseline": "prisma migrate resolve --applied 20260830000000_baseline",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "test": "tsx --tsconfig tsconfig.test.json --test lib/analytics/consent.test.ts lib/analytics/events.test.ts lib/analytics/transport.test.ts lib/app-mode.test.ts lib/health.test.ts lib/calc/capacity.test.ts lib/domain.test.ts lib/actions.validation.test.ts lib/kto/areacode.test.ts lib/kto/client.test.ts lib/kto/refresh.test.ts lib/kto/security.test.ts lib/kto/wire.test.ts lib/kto/windows.test.ts lib/kto/probe.test.ts lib/kto/history-probe.test.ts lib/kto/history.test.ts lib/forecast/model.test.ts lib/forecast/evaluation.test.ts lib/forecast/vintages.test.ts lib/forecast/prospective.test.ts lib/forecast/daily.test.ts lib/forecast/calendar.test.ts lib/forecast/calendar-trial.test.ts && node --test scripts/migrate-sqlite.test.mjs",
    "data:profile": "node --env-file-if-exists=.env --import tsx scripts/profile-kto.ts",
    "data:profile-history": "node --env-file-if-exists=.env --import tsx scripts/profile-kto-history.ts",
    "data:collect-history": "node --env-file-if-exists=.env --import tsx scripts/collect-kto-history.ts",
    "forecast:evaluate": "tsx scripts/evaluate-nonsan-forecast.ts",
    "forecast:calendar": "tsx scripts/evaluate-calendar.ts",
    "forecast:trial:register": "tsx scripts/register-calendar-trial.ts",
    "forecast:trial:verify": "tsx scripts/register-calendar-trial.ts --verify",
    "forecast:verify": "tsx scripts/verify-forecast-evidence.ts",
    "forecast:records": "tsx scripts/forecast-records.ts",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "node scripts/run-demo-e2e.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
