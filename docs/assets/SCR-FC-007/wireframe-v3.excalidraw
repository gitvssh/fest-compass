    {
      "id": "fc7v3-text-005",
      "type": "text",
      "x": 28,
      "y": 132,
      "width": 454.23,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
